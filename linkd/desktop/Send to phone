#!/usr/bin/env bash
# Nautilus "Send to phone" script (Linux Link).
#
# Installation:
#   mkdir -p ~/.local/share/nautilus/scripts
#   cp "Send to phone" ~/.local/share/nautilus/scripts/
#   chmod +x ~/.local/share/nautilus/scripts/"Send to phone"
# Then in Files: right-click on one or more file(s) → Scripts →
# "Send to phone".
#
# (For Nemo: ~/.local/share/nemo/scripts/ ; for Dolphin, see the README.)

LINKD="$HOME/.local/bin/linkd"
count=0
fail=0

# Nautilus provides the selected paths (one per line) in this variable.
while IFS= read -r path; do
    [ -z "$path" ] && continue
    if [ -f "$path" ]; then
        if "$LINKD" send-file "$path" >/dev/null 2>&1; then
            count=$((count + 1))
        else
            fail=$((fail + 1))
        fi
    fi
done <<< "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"

if command -v notify-send >/dev/null 2>&1; then
    if [ "$fail" -eq 0 ]; then
        notify-send "Linux Link" "$count file(s) sent to the phone 📎"
    else
        notify-send "Linux Link" "$count sent, $fail failed. Is the phone connected?"
    fi
fi
