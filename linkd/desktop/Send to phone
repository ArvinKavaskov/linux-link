#!/usr/bin/env bash
# "Send to phone" file-manager script (Linux Link).
#
# One script for Nautilus (GNOME/Zorin), Nemo (Cinnamon) and Caja (MATE): each
# passes the selection in its own environment variable, and custom actions pass
# the paths as arguments instead, so we accept whichever we are given.
#
# Installation:
#   Nautilus : ~/.local/share/nautilus/scripts/
#   Nemo     : ~/.local/share/nemo/scripts/
#   Caja     : ~/.config/caja/scripts/
#   chmod +x "Send to phone"
# Then right-click on one or more file(s) -> Scripts -> "Send to phone".
#
# (Nemo also gets a top-level entry through linux-link-send.nemo_action;
#  Dolphin through the KDE service menu; Thunar through a custom action.)

LINKD="$HOME/.local/bin/linkd"
[ -x "$LINKD" ] || LINKD="linkd"

count=0
fail=0

send() {
    [ -f "$1" ] || return 0
    if "$LINKD" send-file "$1" >/dev/null 2>&1; then
        count=$((count + 1))
    else
        fail=$((fail + 1))
    fi
}

# The file manager's own variable, whichever one is set.
SELECTION="${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-${NEMO_SCRIPT_SELECTED_FILE_PATHS:-${CAJA_SCRIPT_SELECTED_FILE_PATHS:-}}}"

if [ -n "$SELECTION" ]; then
    while IFS= read -r path; do
        [ -n "$path" ] && send "$path"
    done <<< "$SELECTION"
else
    # Called with the paths as arguments instead.
    for path in "$@"; do
        send "$path"
    done
fi

if command -v notify-send >/dev/null 2>&1; then
    if [ "$count" -eq 0 ] && [ "$fail" -eq 0 ]; then
        notify-send "Linux Link" "Nothing to send."
    elif [ "$fail" -eq 0 ]; then
        notify-send "Linux Link" "$count file(s) sent to the phone 📎"
    else
        notify-send "Linux Link" "$count sent, $fail failed. Is the phone connected?"
    fi
fi
