# systemd *user* unit — this is what makes Linux Link automatic:
# the daemon starts at session login and restarts on a crash.
#
# Installation:
#   mkdir -p ~/.config/systemd/user
#   cp linkd.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now linkd

[Unit]
Description=Linux Link daemon (Linux <-> Android continuity)
After=network-online.target bluetooth.target
# Five restarts in a minute is a real bug, not a blip — but giving up after
# the default three would be far too easy on a slow login.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
ExecStart=%h/.local/bin/linkd run
# always, not on-failure: a clean exit still means the phone has nothing to
# talk to. The daemon is supposed to be running whenever the session is.
Restart=always
RestartSec=2
Environment=RUST_LOG=info
# Idle daemon: never let it compete with what the user is actually doing.
Nice=5
IOSchedulingClass=idle

[Install]
WantedBy=default.target
