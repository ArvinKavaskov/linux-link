# systemd *user* unit — this is what makes Linux Link automatic:
# the daemon starts at session login and restarts on a crash.
#
# Installation:
#   mkdir -p ~/.config/systemd/user
#   cp linkd.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now linkd

[Unit]
Description=Linux Link daemon (Linux <-> Android continuity)
After=network-online.target bluetooth.target graphical-session.target
# The graphical session is where DISPLAY and the XDG variables live. Started
# any earlier, the daemon runs blind: D-Bus still works (it only needs
# XDG_RUNTIME_DIR), so everything *seems* fine until the first feature that
# talks to the display server — the second screen — fails with an empty
# environment. Binding to the session also stops the daemon when the session
# ends, instead of leaving it talking to a dead display.
PartOf=graphical-session.target
# Five restarts in a minute is a real bug, not a blip — but giving up after
# the default three would be far too easy on a slow login.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
ExecStart=%h/.local/bin/linkd run
# always, not on-failure: a clean exit still means the phone has nothing to
# talk to. The daemon is supposed to be running whenever the session is.
Restart=always
RestartSec=2
Environment=RUST_LOG=info
# Idle daemon: never let it compete with what the user is actually doing.
Nice=5
IOSchedulingClass=idle

[Install]
WantedBy=graphical-session.target
